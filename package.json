{
  "name": "debugtron-tauri",
  "productName": "Debugtron",
  "version": "1.0.3",
  "description": "Debug in-production Electron based App - Tauri Edition",
  "repository": {
    "type": "git",
    "url": "https://github.com/reamd7/debugtron-tauri.git"
  },
  "license": "MIT",
  "author": "reamd7 <reamd7@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:arm64": "tauri build --target aarch64-apple-darwin",
    "tauri:build:x86_64": "tauri build --target x86_64-apple-darwin",
    "tauri:build:windows:gnu": "tauri build --target x86_64-pc-windows-gnu",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "version": "node scripts/sync-version.cjs && git add src-tauri/Cargo.toml src-tauri/tauri.conf.json",
    "release": "node scripts/release.cjs",
    "publish-release": "node scripts/publish-release.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.10.1",
    "@tauri-apps/api": "^1.6.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "dirs": "^0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@tauri-apps/cli": "^1.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
